{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@shared/emergency": ["../shared/src/emergency"],
      "@neuralnexus/shared": ["../shared/src/index"]
    }
  },
  "include": ["src/**/*", "../shared/**/*"]
}
