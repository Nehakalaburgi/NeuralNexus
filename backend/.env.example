# Port for ResQAlloc WebSocket and REST API
PORT=5000

# Environment
NODE_ENV=development

# Local MongoDB (default)
MONGO_URI=mongodb://127.0.0.1:27017/resqalloc?directConnection=true

# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resqalloc?retryWrites=true&w=majority

# Gemini API Key (for Multi-Agent AI Pipeline)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
