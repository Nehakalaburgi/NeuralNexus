{
  "name": "neuralnexus-backend",
  "version": "1.0.0",
  "description": "NeuralNexus Emergency Control Room AI Multi-Agent & Dynamic Replanning Backend API",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "demo:replan": "tsx src/replanning/demoReplanning.ts",
    "test:replan": "tsx src/replanning/testSuite.ts",
    "test:scenario": "tsx src/scenarios/testScenario.ts",
    "test:disruption": "tsx src/services/testDisruptionService.ts",
    "test:disruption:single": "tsx src/testDisruption.ts",
    "test:replanning:single": "tsx src/testReplanning.ts",
    "test:replanning:verification": "tsx src/testReplanningVerification.ts",
    "test:newincident": "tsx src/testNewIncident.ts",
    "test:decisionlog": "tsx src/testDecisionLog.ts",
    "test:ai": "tsx src/testAiPipeline.ts",
    "test:integration": "tsx src/testIntegrationEngine.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.10.1",
    "socket.io": "^4.8.4",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
