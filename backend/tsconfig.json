{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@neuralnexus/shared": ["../shared/src/index", "../shared/dist/index.d.ts"],
      "@shared/*": ["../shared/src/*", "../shared/*"],
      "@shared/emergency": ["../shared/src/emergency"]
    }
  },
  "include": ["src/**/*"]
}
